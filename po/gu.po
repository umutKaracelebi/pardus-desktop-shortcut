msgid "Application added to desktop."
msgstr "ડેસ્કટોપ પર એપ્લિકેશન ઉમેરવામાં આવી."

msgid "Warning"
msgstr "ચેતવણી"

msgid "Removed from Desktop"
msgstr "ડેસ્કટોપ પરથી દૂર કર્યું"

msgid "Shortcut removed from desktop."
msgstr "ડેસ્કટૉપ પરથી શૉર્ટકટ દૂર કર્યો."

