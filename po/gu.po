msgid "{} not found."
msgstr "{} મળ્યો નથી."

msgid "Only .desktop files are supported."
msgstr "માત્ર .desktop ફાઇલો જ સમર્થિત છે."

msgid "{} is already on the desktop."
msgstr "{} પહેલેથી જ ડેસ્કટોપ પર છે."

msgid "Copy error: {}"
msgstr "કૉપિ ભૂલ: {}"

msgid "Shortcut creation error: {}"
msgstr "શૉર્ટકટ બનાવટ ભૂલ: {}"

msgid "Application name cannot be empty."
msgstr "એપ્લિકેશનનું નામ ખાલી હોઈ શકતું નથી."

msgid "Execution command cannot be empty."
msgstr "એક્ઝેક્યુશન આદેશ ખાલી હોઈ શકતો નથી."

msgid "Creation error: {}"
msgstr "બનાવટ ભૂલ: {}"

msgid "{} was not found on the desktop."
msgstr "ડેસ્કટોપ પર {} મળ્યું નથી."

msgid "{} removed from desktop."
msgstr "ડેસ્કટૉપ પરથી {} દૂર કર્યું."

msgid "Removal error: {}"
msgstr "દૂર કરવામાં ભૂલ: {}"

msgid "Remove from Desktop"
