msgid "Application name cannot be empty."
msgstr "အပလီကေးရှင်းအမည်ကို ဗလာမဖြစ်ရပါ။"

msgid "Execution command cannot be empty."
msgstr "Execution command ကို ဗလာမဖြစ်နိုင်ပါဘူး။"

msgid "Creation error: {}"
msgstr "ဖန်တီးမှု အမှား- {}"

