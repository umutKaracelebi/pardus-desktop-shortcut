msgstr "{} ကို ဒက်စ်တော့မှ ဖယ်ရှားခဲ့သည်။"

msgid "Removal error: {}"
msgstr "ဖယ်ရှားရေး အမှား- {}"

msgid "Remove from Desktop"
msgstr "Desktop မှဖယ်ရှားပါ။"

msgid "Remove desktop shortcut"
msgstr "ဒက်စ်တော့ဖြတ်လမ်းကို ဖယ်ရှားပါ။"

msgid "Add to Desktop"
msgstr "Desktop သို့ထည့်ပါ။"

msgid "Add to desktop as a shortcut"
msgstr "ဖြတ်လမ်းလင့်ခ်အဖြစ် ဒက်စ်တော့သို့ ထည့်ပါ။"

