msgid "Application added to desktop."
msgstr "အပလီကေးရှင်းကို ဒက်စ်တော့တွင် ထည့်ထားသည်။"

msgid "Warning"
msgstr "သတိပေးချက်"

msgid "Removed from Desktop"
msgstr "Desktop မှ ဖယ်ရှားခဲ့သည်။"

msgid "Shortcut removed from desktop."
msgstr "ဖြတ်လမ်းလင့်ခ်ကို ဒက်စ်တော့မှ ဖယ်ရှားလိုက်ပါပြီ။"

