msgid "{} not found."
msgstr "{} မတွေ့ပါ။"

msgid "Only .desktop files are supported."
msgstr ".desktop ဖိုင်များကိုသာ ပံ့ပိုးထားပါသည်။"

msgid "{} is already on the desktop."
msgstr "{} သည် ဒက်စ်တော့ပေါ်တွင် ရှိနှင့်ပြီးဖြစ်သည်။"

msgid "Copy error: {}"
msgstr "ကူးယူမှု အမှား- {}"

