msgid "{} not found."
msgstr "{} காணப்படவில்லை."

msgid "Only .desktop files are supported."
msgstr ".desktop கோப்புகள் மட்டுமே ஆதரிக்கப்படும்."

msgid "{} is already on the desktop."
msgstr "{} ஏற்கனவே டெஸ்க்டாப்பில் உள்ளது."

msgid "Copy error: {}"
msgstr "நகல் பிழை: {}"

msgid "Shortcut creation error: {}"
msgstr "குறுக்குவழியை உருவாக்குவதில் பிழை: {}"

msgid "Application name cannot be empty."
msgstr "விண்ணப்பத்தின் பெயர் காலியாக இருக்கக்கூடாது."

msgid "Execution command cannot be empty."
msgstr "செயல்படுத்தும் கட்டளை காலியாக இருக்கக்கூடாது."

msgid "Creation error: {}"
msgstr "உருவாக்கப் பிழை: {}"

msgid "{} was not found on the desktop."
msgstr "டெஸ்க்டாப்பில் {} காணப்படவில்லை."

msgid "{} removed from desktop."
msgstr "{} டெஸ்க்டாப்பில் இருந்து அகற்றப்பட்டது."

msgid "Removal error: {}"
msgstr "அகற்றுவதில் பிழை: {}"

msgid "Remove from Desktop"
msgstr "டெஸ்க்டாப்பில் இருந்து அகற்று"

msgid "Remove desktop shortcut"
msgstr "டெஸ்க்டாப் குறுக்குவழியை அகற்று"

msgid "Add to Desktop"
msgstr "டெஸ்க்டாப்பில் சேர்க்கவும்"

msgid "Add to desktop as a shortcut"
msgstr "குறுக்குவழியாக டெஸ்க்டாப்பில் சேர்க்கவும்"

msgid "Added to Desktop"
msgstr "டெஸ்க்டாப்பில் சேர்க்கப்பட்டது"

msgid "applications added to desktop."
msgstr "டெஸ்க்டாப்பில் பயன்பாடுகள் சேர்க்கப்பட்டன."

msgid "Application added to desktop."
msgstr "டெஸ்க்டாப்பில் பயன்பாடு சேர்க்கப்பட்டது."

msgid "Warning"
msgstr "எச்சரிக்கை"

msgid "Removed from Desktop"
msgstr "டெஸ்க்டாப்பில் இருந்து அகற்றப்பட்டது"

msgid "Shortcut removed from desktop."
msgstr "டெஸ்க்டாப்பில் இருந்து குறுக்குவழி அகற்றப்பட்டது."

