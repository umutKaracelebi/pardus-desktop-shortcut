msgid "{} not found."
msgstr "{} পাওয়া যায়নি।"

msgid "Only .desktop files are supported."
msgstr "শুধুমাত্র .desktop ফাইল সমর্থিত."

msgid "{} is already on the desktop."
msgstr "{} ইতিমধ্যেই ডেস্কটপে রয়েছে৷"

msgid "Copy error: {}"
msgstr "কপি ত্রুটি: {}"

msgid "Shortcut creation error: {}"
msgstr "শর্টকাট তৈরির ত্রুটি: {}"

msgid "Application name cannot be empty."
msgstr "আবেদনের নাম খালি রাখা যাবে না।"

msgid "Execution command cannot be empty."
msgstr "এক্সিকিউশন কমান্ড খালি থাকতে পারে না।"

msgid "Creation error: {}"
msgstr "সৃষ্টি ত্রুটি: {}"

msgid "{} was not found on the desktop."
msgstr "ডেস্কটপে {} পাওয়া যায়নি।"

msgid "{} removed from desktop."
msgstr "{} ডেস্কটপ থেকে সরানো হয়েছে।"

msgid "Removal error: {}"
msgstr "অপসারণ ত্রুটি: {}"

msgid "Remove from Desktop"
msgstr "ডেস্কটপ থেকে সরান"

msgid "Remove desktop shortcut"
