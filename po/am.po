msgid "{} not found."
msgstr "{} አልተገኘም።"

msgid "Only .desktop files are supported."
msgstr "የዴስክቶፕ ፋይሎች ብቻ ናቸው የሚደገፉት።"

msgid "{} is already on the desktop."
msgstr "{} አስቀድሞ በዴስክቶፕ ላይ ነው።"

msgid "Copy error: {}"
msgstr "የመቅዳት ስህተት፡ {}"

msgid "Shortcut creation error: {}"
msgstr "አቋራጭ የመፍጠር ስህተት፡ {}"

msgid "Application name cannot be empty."
msgstr "የመተግበሪያ ስም ባዶ ሊሆን አይችልም።"

msgid "Execution command cannot be empty."
msgstr "የማስፈጸሚያ ትእዛዝ ባዶ ሊሆን አይችልም።"

msgid "Creation error: {}"
msgstr "የፍጥረት ስህተት፡ {}"

msgid "{} was not found on the desktop."
msgstr "{} በዴስክቶፕ ላይ አልተገኘም።"

msgid "{} removed from desktop."
msgstr "{} ከዴስክቶፕ ተወግዷል።"

msgid "Removal error: {}"
msgstr "የማስወገድ ስህተት፡ {}"

msgid "Remove from Desktop"
msgstr "ከዴስክቶፕ አስወግድ"

msgid "Remove desktop shortcut"
msgstr "የዴስክቶፕ አቋራጭን ያስወግዱ"

msgid "Add to Desktop"
msgstr "ወደ ዴስክቶፕ አክል"

msgid "Add to desktop as a shortcut"
msgstr "እንደ አቋራጭ ወደ ዴስክቶፕ ያክሉ"

msgid "Added to Desktop"
msgstr "ወደ ዴስክቶፕ ታክሏል።"

msgid "applications added to desktop."
msgstr "መተግበሪያዎች ወደ ዴስክቶፕ ታክለዋል."

msgid "Application added to desktop."
msgstr "መተግበሪያ ወደ ዴስክቶፕ ታክሏል።"

msgid "Warning"
msgstr "ማስጠንቀቂያ"

msgid "Removed from Desktop"
msgstr "ከዴስክቶፕ ተወግዷል"

msgid "Shortcut removed from desktop."
msgstr "አቋራጭ ከዴስክቶፕ ተወግዷል።"

