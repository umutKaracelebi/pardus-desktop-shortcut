msgid "{} not found."
msgstr "{} കണ്ടെത്തിയില്ല."

msgid "Only .desktop files are supported."
msgstr ".desktop ഫയലുകൾ മാത്രമേ പിന്തുണയ്ക്കൂ."

msgid "{} is already on the desktop."
msgstr "{} ഇതിനകം ഡെസ്ക്ടോപ്പിലാണ്."

msgid "Copy error: {}"
msgstr "പകർത്തൽ പിശക്: {}"

msgid "Shortcut creation error: {}"
msgstr "കുറുക്കുവഴി സൃഷ്ടിക്കുന്നതിൽ പിശക്: {}"

msgid "Application name cannot be empty."
msgstr "അപേക്ഷയുടെ പേര് ശൂന്യമായിരിക്കരുത്."

msgid "Execution command cannot be empty."
msgstr "എക്സിക്യൂഷൻ കമാൻഡ് ശൂന്യമായിരിക്കരുത്."

msgid "Creation error: {}"
msgstr "സൃഷ്ടിക്കൽ പിശക്: {}"

msgid "{} was not found on the desktop."
msgstr "{} ഡെസ്ക്ടോപ്പിൽ കണ്ടെത്തിയില്ല."

msgid "{} removed from desktop."
msgstr "{} ഡെസ്ക്ടോപ്പിൽ നിന്ന് നീക്കംചെയ്തു."

msgid "Removal error: {}"
msgstr "നീക്കം ചെയ്യുന്നതിൽ പിശക്: {}"

msgid "Remove from Desktop"
msgstr "ഡെസ്ക്ടോപ്പിൽ നിന്ന് നീക്കം ചെയ്യുക"

msgid "Remove desktop shortcut"
msgstr "ഡെസ്ക്ടോപ്പ് കുറുക്കുവഴി നീക്കം ചെയ്യുക"

msgid "Add to Desktop"
msgstr "ഡെസ്ക്ടോപ്പിലേക്ക് ചേർക്കുക"

msgid "Add to desktop as a shortcut"
msgstr "ഒരു കുറുക്കുവഴിയായി ഡെസ്ക്ടോപ്പിലേക്ക് ചേർക്കുക"

msgid "Added to Desktop"
msgstr "ഡെസ്ക്ടോപ്പിൽ ചേർത്തു"

msgid "applications added to desktop."
msgstr "ഡെസ്ക്ടോപ്പിലേക്ക് ആപ്ലിക്കേഷനുകൾ ചേർത്തു."

msgid "Application added to desktop."
msgstr "ഡെസ്ക്ടോപ്പിലേക്ക് ആപ്ലിക്കേഷൻ ചേർത്തു."

msgid "Warning"
msgstr "മുന്നറിയിപ്പ്"

msgid "Removed from Desktop"
msgstr "ഡെസ്ക്ടോപ്പിൽ നിന്ന് നീക്കം ചെയ്തു"

msgid "Shortcut removed from desktop."
msgstr "ഡെസ്ക്ടോപ്പിൽ നിന്ന് കുറുക്കുവഴി നീക്കം ചെയ്തു."

