msgid "Application name cannot be empty."
msgstr "Програмын нэр хоосон байж болохгүй."

msgid "Execution command cannot be empty."
msgstr "Гүйцэтгэх тушаал хоосон байж болохгүй."

msgid "Creation error: {}"
msgstr "Бүтээлийн алдаа: {}"

msgid "{} was not found on the desktop."
msgstr "{} ширээний компьютер дээр олдсонгүй."

msgid "{} removed from desktop."
msgstr "{} ширээний компьютерээс хасагдсан."

msgid "Removal error: {}"
msgstr "Устгах алдаа: {}"

msgid "Remove from Desktop"
msgstr "Ширээний компьютерээс устгана уу"

