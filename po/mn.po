msgid "{} not found."
msgstr "{} олдсонгүй."

msgid "Only .desktop files are supported."
msgstr "Зөвхөн .desktop файлуудыг дэмждэг."

msgid "{} is already on the desktop."
msgstr "{} аль хэдийн ширээний компьютер дээр байна."

msgid "Copy error: {}"
