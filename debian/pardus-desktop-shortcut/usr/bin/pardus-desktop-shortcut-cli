#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
pardus-desktop-shortcut — Komut Satırı Aracı

Kullanım:
    pardus-desktop-shortcut --add firefox.desktop
    pardus-desktop-shortcut --add /usr/share/applications/firefox.desktop
    pardus-desktop-shortcut --create --name "Uygulamam" --exec "/usr/bin/app"
    pardus-desktop-shortcut --remove firefox.desktop
    pardus-desktop-shortcut --list

Copyright (C) 2026 Umut Karacelebi
License: GPL-3.0
"""

import sys
import os
import argparse

# Core kütüphaneyi yükle
sys.path.insert(0, "/usr/share/pardus/desktop-shortcut")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__))))

from desktop_shortcut import DesktopShortcut


# ---------------------------------------------------------------------------
# Renk yardımcıları (terminal çıktısı için)
# ---------------------------------------------------------------------------
if sys.stdout.isatty():
    GREEN = "\033[0;32m"
    RED = "\033[0;31m"
    YELLOW = "\033[1;33m"
    BOLD = "\033[1m"
    RESET = "\033[0m"
else:
    GREEN = RED = YELLOW = BOLD = RESET = ""


def print_success(msg):
    print("{}✓ {}{}".format(GREEN, msg, RESET))


def print_error(msg):
    print("{}✗ {}{}".format(RED, msg, RESET), file=sys.stderr)


def print_warning(msg):
    print("{}⚠ {}{}".format(YELLOW, msg, RESET), file=sys.stderr)


# ---------------------------------------------------------------------------
# Komutlar
# ---------------------------------------------------------------------------
def cmd_add(args):
    """Bir .desktop dosyasını masaüstüne ekle."""
    shortcut = DesktopShortcut()

    app_name = args.add

    # .desktop dosyasını bul
    filepath = shortcut.find_desktop_file(app_name)
    if not filepath:
        print_error("'{}' bulunamadı.".format(app_name))
        print_warning("Tam yol veya dosya adı deneyin: pardus-desktop-shortcut --add firefox.desktop")
        return 1

    ok, result = shortcut.copy_to_desktop(filepath, overwrite=args.overwrite)
    if ok:
        print_success("Masaüstüne eklendi: {}".format(result))
        return 0
    else:
        print_error(result)
        return 1


def cmd_create(args):
    """Sıfırdan bir .desktop dosyası oluştur."""
    shortcut = DesktopShortcut()

    if not args.name:
        print_error("--name parametresi gereklidir.")
        return 1
    if not args.exec_path:
        print_error("--exec parametresi gereklidir.")
        return 1

    ok, result = shortcut.create_desktop_entry(
        name=args.name,
        exec_path=args.exec_path,
        icon=args.icon or "",
        comment=args.comment or "",
        categories=args.categories or "Application;",
        terminal=args.terminal,
        overwrite=args.overwrite,
    )

    if ok:
        print_success("Masaüstünde oluşturuldu: {}".format(result))
        return 0
    else:
        print_error(result)
        return 1


def cmd_remove(args):
    """Masaüstünden bir kısayolu kaldır."""
    shortcut = DesktopShortcut()

    filename = args.remove
    if not filename.endswith(".desktop"):
        filename += ".desktop"

    ok, msg = shortcut.remove_from_desktop(filename)
    if ok:
        print_success(msg)
        return 0
    else:
        print_error(msg)
        return 1


def cmd_list(args):
    """Yüklü uygulamaları listele."""
    shortcut = DesktopShortcut()
    apps = shortcut.list_installed_apps()

    if not apps:
        print_warning("Hiç uygulama bulunamadı.")
        return 0

    # Masaüstünde olanları işaretle
    max_name = max(len(a["name"]) for a in apps)
    max_name = min(max_name, 40)

    header = "  {:<{}} {:<40} {}".format("Ad", max_name, "Dosya", "Masaüstü")
    print()
    print("{}{}{}".format(BOLD, header, RESET))
    print("  " + "─" * (max_name + 50))

    for app in apps:
        name = app["name"][:max_name]
        on_desktop = shortcut.is_on_desktop(app["filename"])
        marker = "{}● Evet{}".format(GREEN, RESET) if on_desktop else "  Hayır"

        print("  {:<{}} {:<40} {}".format(
            name, max_name, app["filename"][:40], marker
        ))

    print()
    print("  Toplam: {} uygulama".format(len(apps)))
    return 0


# ---------------------------------------------------------------------------
# Ana argüman ayrıştırıcı
# ---------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        prog="pardus-desktop-shortcut",
        description="Pardus Masaüstüne Kısayol Ekleme Aracı",
        epilog=(
            "Örnekler:\n"
            "  %(prog)s --add firefox\n"
            "  %(prog)s --add /usr/share/applications/firefox.desktop\n"
            "  %(prog)s --create --name 'Uygulamam' --exec '/usr/bin/app'\n"
            "  %(prog)s --remove firefox.desktop\n"
            "  %(prog)s --list\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # Ana komutlar (birbirini dışlar)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument(
        "--add", "-a",
        metavar="UYGULAMA",
        help="Bir uygulamayı masaüstüne ekle (dosya adı veya tam yol)",
    )
    group.add_argument(
        "--create", "-c",
        action="store_true",
        help="Yeni bir .desktop kısayolu oluştur",
    )
    group.add_argument(
        "--remove", "-r",
        metavar="DOSYA",
        help="Masaüstünden bir kısayolu kaldır",
    )
    group.add_argument(
        "--list", "-l",
        action="store_true",
        help="Yüklü uygulamaları listele",
    )

    # --create seçenekleri
    parser.add_argument("--name", "-n", help="Uygulama adı")
    parser.add_argument("--exec", "-e", dest="exec_path", help="Çalıştırılacak komut")
    parser.add_argument("--icon", "-i", help="İkon adı veya yolu")
    parser.add_argument("--comment", help="Kısa açıklama")
    parser.add_argument("--categories", help="Kategoriler (noktalı virgülle ayrılmış)")
    parser.add_argument("--terminal", "-t", action="store_true", help="Terminalde çalıştır")

    # Genel seçenekler
    parser.add_argument(
        "--overwrite", "-f",
        action="store_true",
        help="Mevcut dosyanın üzerine yaz",
    )
    parser.add_argument(
        "--version", "-V",
        action="version",
        version="pardus-desktop-shortcut 1.0.0",
    )

    args = parser.parse_args()

    # Komutu çalıştır
    if args.add:
        return cmd_add(args)
    elif args.create:
        return cmd_create(args)
    elif args.remove:
        return cmd_remove(args)
    elif args.list:
        return cmd_list(args)

    return 0


if __name__ == "__main__":
    sys.exit(main())
